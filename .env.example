# Copy to .env only for a new checkout. Keep an existing .env unchanged.
# .env is private; this example contains no real credentials.
POSTGRES_DB=hsp
POSTGRES_USER=hsp
# Required: set a strong, unique password before initializing a new PostgreSQL volume.
# For an existing DB, use its current password; changing this does not reset the DB password.
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

SPRING_APPLICATION_NAME=hsp-backend
JPA_DDL_AUTO=none
SERVER_PORT=8080

CORS_ALLOWED_ORIGINS=http://localhost:5173
# Use true when deploying behind HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
API_DOCS_ENABLED=true
